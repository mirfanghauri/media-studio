# ==============================================================================
# Media Studio — Environment Configuration Template
# Copy this file to .env and customize for your deployment environment:
#   cp .env.example .env
#
# Note: AI Provider credentials (OpenAI, Azure, Vertex, Bedrock, xAI) can be
# configured directly in the web UI under Settings (persisted in SQLite).
# ==============================================================================

# Application Environment & Image Version
# Pin to a specific release (e.g. 1.0.2) or use 'latest'
MEDIA_STUDIO_VERSION=1.0.3
NODE_ENV=production

# Storage & Infrastructure
STORAGE_PATH=/app/storage
REDIS_HOST=redis
REDIS_PORT=6379
IMAGINARY_URL=http://imaginary:9000

# Pipeline & Worker Limits
MAX_FILE_SIZE=500mb
WORKER_CONCURRENCY=2

# Security & Authentication (Change these before deploying!)
JWT_SECRET=replace_with_a_secure_random_secret_key_32_chars
ADMIN_PASSWORD=replace_with_a_strong_password

# Exposed Port Mappings (Host : Container)
API_PORT=3500
FRONTEND_PORT=3501
QUEUE_MONITOR_PORT=3502

